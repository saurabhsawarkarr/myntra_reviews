{
  "collection": {
    "play_store_max_reviews": 500000,
    "app_store_max_reviews": 50000,
    "reddit_max_posts_per_query": 350,
    "reddit_max_comments_per_post": 50,
    "youtube_max_videos_per_query": 30,
    "youtube_max_comments_per_video": 500,
    "web_search_max_results": 50
  },
  "cleaning": {
    "min_text_length": 20,
    "max_text_length": 10000
  },
  "relevance": {
    "keyword_weight": 0.4,
    "semantic_weight": 0.6,
    "relevance_threshold": 0.45,
    "embedding_model": "all-MiniLM-L6-v2"
  },
  "ai_extraction": {
    "groq_model": "qwen/qwen3.8-27b",
    "batch_size": 10,
    "max_retries": 3,
    "retry_delay_seconds": 5
  },
  "scoring": {
    "frequency_weight": 0.25,
    "severity_weight": 0.25,
    "workaround_weight": 0.20,
    "metric_relevance_weight": 0.20,
    "evidence_strength_weight": 0.10
  }
}
